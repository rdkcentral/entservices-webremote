set(autostart ${PLUGIN_WEBREMOTE_AUTOSTART})
set(preconditions Platform)
set(callsign "org.rdk.WebRemote")

if(PLUGIN_WEBREMOTE_STARTUPORDER)
    set(startuporder ${PLUGIN_WEBREMOTE_STARTUPORDER})
endif()

if(PLUGIN_WEBREMOTE_DEVICEID)
    map()
        kv(deviceid ${PLUGIN_WEBREMOTE_DEVICEID})
    end()
    ans(configuration)
endif()
